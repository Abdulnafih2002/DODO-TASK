<mxfile host="app.diagrams.net" agent="dodo-devsecops" version="24.0.0">
  <diagram name="Dodo Payments DevSecOps Architecture" id="dodo-arch-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Dodo Payments — ledger-api : hardened DevSecOps architecture" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== Task 2: CI/CD swimlane ===================== -->
        <mxCell id="ci" value="GitHub Actions — Secure Supply Chain (Task 2)" style="rounded=1;dashed=1;dashPattern=6 4;fillColor=#eef4ff;strokeColor=#2a6bb0;fontColor=#1e40af;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ci1" value="gitleaks&#10;(secrets)" style="rounded=1;fillColor=#ffffff;strokeColor=#2a6bb0;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="140" height="56" as="geometry" /></mxCell>
        <mxCell id="ci2" value="Semgrep&#10;(SAST)" style="rounded=1;fillColor=#ffffff;strokeColor=#2a6bb0;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="240" y="100" width="140" height="56" as="geometry" /></mxCell>
        <mxCell id="ci3" value="Trivy&#10;(CVE scan)" style="rounded=1;fillColor=#ffffff;strokeColor=#2a6bb0;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="140" height="56" as="geometry" /></mxCell>
        <mxCell id="ci4" value="docker build&#10;+ image scan" style="rounded=1;fillColor=#ffffff;strokeColor=#2a6bb0;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="ci5" value="cosign sign&#10;+ SLSA + SBOM" style="rounded=1;fillColor=#e2f2ef;strokeColor=#0b8f80;fontColor=#0a6a5f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="100" width="160" height="56" as="geometry" /></mxCell>
        <mxCell id="ghcr" value="GHCR&#10;(registry)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a6bb0;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="990" y="92" width="120" height="72" as="geometry" /></mxCell>
        <mxCell id="cie1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;strokeColor=#2a6bb0;" edge="1" parent="1" source="ci1" target="ci2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cie2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;strokeColor=#2a6bb0;" edge="1" parent="1" source="ci2" target="ci3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cie3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;strokeColor=#2a6bb0;" edge="1" parent="1" source="ci3" target="ci4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cie4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;strokeColor=#2a6bb0;" edge="1" parent="1" source="ci4" target="ci5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cie5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;strokeColor=#2a6bb0;" edge="1" parent="1" source="ci5" target="ghcr"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- GHCR -> Admission -->
        <mxCell id="edge_ghcr_adm" value="signed image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;strokeColor=#374151;fontColor=#374151;" edge="1" parent="1" source="ghcr" target="adm"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===================== Task 1: Admission ===================== -->
        <mxCell id="adm" value="Admission control (Task 1)&#10;Kyverno policies + Pod Security &#39;restricted&#39;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fbf0dd;strokeColor=#b26a06;fontColor=#7c4a02;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="230" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="blocked" value="BLOCKED&#10;root / :latest / unsigned&#10;/ weak securityContext" style="rounded=1;fillColor=#fbe9e9;strokeColor=#c23b3b;fontColor=#8f2626;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="250" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="edge_adm_block" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;strokeColor=#c23b3b;fontColor=#c23b3b;dashed=1;" edge="1" parent="1" source="adm" target="blocked"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_adm_ns" value="admit hardened" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;strokeColor=#1f8a4c;fontColor=#1f8a4c;fontStyle=1;" edge="1" parent="1" source="adm" target="ns"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===================== Task 3: namespace / mesh ===================== -->
        <mxCell id="ns" value="namespace: payments  (PCI cardholder-data-environment)  —  istio-injection enabled" style="rounded=1;dashed=1;dashPattern=6 4;fillColor=#f3fbf9;strokeColor=#0b8f80;fontColor=#0a6a5f;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="120" y="410" width="820" height="260" as="geometry" />
        </mxCell>
        <mxCell id="reporting" value="reporting  (neighbour)&#10;ServiceAccount identity&#10;+ Envoy sidecar" style="rounded=1;fillColor=#ffffff;strokeColor=#0b8f80;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="160" y="470" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ledger" value="ledger-api&#10;non-root (uid 10001), read-only rootfs,&#10;drop-ALL caps, seccomp RuntimeDefault&#10;+ Envoy sidecar" style="rounded=1;fillColor=#e2f2ef;strokeColor=#0b8f80;fontColor=#0a3f39;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="460" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="secret" value="SOPS-encrypted Secret&#10;(envFrom) — no plaintext in git" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#0b8f80;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="180" y="585" width="200" height="66" as="geometry" />
        </mxCell>
        <mxCell id="edge_rep_led" value="mTLS STRICT  +  AuthorizationPolicy&#10;allow only SPIFFE id ...sa/reporting  (else 403)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;strokeWidth=3;strokeColor=#0b8f80;fontColor=#0a6a5f;fontStyle=1;" edge="1" parent="1" source="reporting" target="ledger"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_sec_led" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;strokeColor=#0b8f80;" edge="1" parent="1" source="secret" target="ledger"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- NetworkPolicy underlay -->
        <mxCell id="np" value="Kubernetes NetworkPolicy — default-deny + explicit allows (L3/L4 defense-in-depth, underneath the mesh)" style="rounded=1;dashed=1;fillColor=#eef1f3;strokeColor=#6a7480;fontColor=#454e59;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="690" width="820" height="40" as="geometry" />
        </mxCell>

        <!-- istiod CA -->
        <mxCell id="istiod" value="istiod = mesh CA&#10;issues + rotates SPIFFE&#10;workload certs (~24h)" style="rounded=1;fillColor=#efe9fb;strokeColor=#7c5cd6;fontColor=#4c2f9c;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="470" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="edge_ca_rep" value="cert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=open;dashed=1;html=1;strokeColor=#7c5cd6;fontColor=#7c5cd6;" edge="1" parent="1" source="istiod" target="reporting"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_ca_led" value="cert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=open;dashed=1;html=1;strokeColor=#7c5cd6;fontColor=#7c5cd6;" edge="1" parent="1" source="istiod" target="ledger"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend:  teal = Task 1 hardening + Task 3 mesh   |   blue = Task 2 supply chain   |   purple = Istio CA   |   red = blocked by policy   |   amber = admission gate" style="text;html=1;align=left;fontSize=11;fontColor=#6a7480;" vertex="1" parent="1">
          <mxGeometry x="40" y="748" width="1120" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
